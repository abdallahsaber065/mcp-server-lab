# ==============================================================================
# Cornerstone Realty Group — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# SQLite Default (Zero-dependency local dev):
DATABASE_URL=sqlite:///./db/realty_mcp.db

# PostgreSQL Production / Shared Container Configuration:
# Format: postgresql+asyncpg://<custom_user>:<custom_password>@<host>:<port>/<custom_db_name>
# DATABASE_URL=postgresql+asyncpg://cornerstone_user:cornerstone_secure_pass@localhost:5434/cornerstone_realty

# ------------------------------------------------------------------------------
# 2. Redis Distributed Caching & Token Blacklist
# ------------------------------------------------------------------------------
# Format: redis://[:password]@<host>:<port>/<db_index>
REDIS_URL=redis://:cornerstone_redis_pass@localhost:6380/0

# Redis Namespace Key Prefix (Crucial for shared Redis instances in production):
REDIS_KEY_PREFIX=cornerstone:

# ------------------------------------------------------------------------------
# 3. JWT Authentication & Security Tokens
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=cornerstone_production_secret_key_change_me_in_production_882194
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 4. Server & Transport Configuration
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
MCP_TRANSPORT=stdio
MCP_PORT=8000

# ------------------------------------------------------------------------------
# 5. LLM Provider API Keys
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
