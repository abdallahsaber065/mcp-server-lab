# ------------------------------------------------------------------------------
# 2. Local Caddy Gateway Setup (Optional Local Testing on port 80 / 443)
# ------------------------------------------------------------------------------
:80 {
    encode zstd gzip

    # Root directory pointing to local built frontend
    root * ./web/dist

    # Proxy backend API endpoints
    handle /api/* {
        reverse_proxy 127.0.0.1:8000 {
            flush_interval -1
        }
    }

    handle /mcp/* {
        reverse_proxy 127.0.0.1:8000 {
            flush_interval -1
        }
    }

    # Static Assets & SPA Fallback
    handle /assets/* {
        file_server
    }

    handle {
        try_files {path} /index.html
        file_server
    }
}
